# The tutorial reads only these LC_* names, not COP Studio's server settings.
# File: .env next to config.py. Process LC_* variables take precedence.
LC_API_KEY=replace-with-your-provider-key
# Official OpenAI: https://api.openai.com/v1
# Third-party gateway: replace with THAT provider's exact base path.
LC_BASE_URL=https://api.openai.com/v1
# Use a model ID available to your selected provider; no model is assumed.
LC_MODEL=replace-with-your-provider-model-id
LC_SYSTEM_PROMPT=Answer in one short sentence.
