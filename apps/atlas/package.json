{
  "name": "@cop-studio/atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "node scripts/content.mjs",
    "dev": "pnpm content && vite --host 127.0.0.1",
    "build": "pnpm content && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "typecheck": "pnpm content && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.0.0",
    "typescript": "5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
