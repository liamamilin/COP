  "artifact_id": "ggplot2-capability-map-v0",
  "topic": {
    "name": "ggplot2 数据可视化",
    "scope": "ggplot2 的常见数据展示用途以及 patchwork 图形组合扩展；不包含所有扩展包",
    "purpose": "让初学者知道能制作哪些数据图形，以及每种用途涉及的核心概念和操作",
    "exclusions": [
      "不提供所有绘图函数的百科大全",
      "不编排强制逐步教程"
    ]
  },
  "sources": [
    {
      "id": "ggplot-home",
      "title": "ggplot2 官方网站 — Overview",
      "url": "https://ggplot2.tidyverse.org/",
      "version": "4.0.3",
      "excerpt": "Start with ggplot(), data, aes(), add layers, scales, facets and coordinates."
    },
    {
      "id": "patchwork-guide",
      "title": "patchwork — Getting Started",
      "url": "https://patchwork.data-imaginist.com/articles/patchwork.html",
      "excerpt": "Combine independently created ggplots with +; | places plots beside each other; / stacks plots."
    }
  ],
  "possibilities": [
    {
