{
  "schema_version": "0.4",
  "source_registry": "catalog/topic-registry.v0.4.json",
  "state": "proposal_only_not_executed",
  "output_root": "outputs/<slug>/",
  "max_parallel_global": 2,
  "default_validation": "python3 .agents/skills/p-discovery/scripts/validate.py outputs/<slug>/possibilities.json",
  "pipeline": [
    "selected",
    "researching",
    "source_review",
    "accepted_or_rework",
    "merge_after_review",
    "published_in_atlas_after_catalog_update"
  ],
  "require_artifacts": [
    "possibilities.json",
    "possibilities.md",
    "validation-report.txt",
    "discovery-log.md",
    "source-coverage.json"
  ],
