APP_ENV=development
APP_SECRET=replace-with-a-long-random-value
DATABASE_URL=postgresql+psycopg://cop:cop@postgres:5432/cop
DATA_DIR=/data
# Host port for the Compose postgres. Change it if 5432 is already in use.
POSTGRES_HOST_PORT=5432
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000
# Browser calls use the same-origin Next proxy; the proxy reaches the API.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Optional host mapping for the web container. Use 3001 only if 3000 is busy.
WEB_HOST_PORT=3000
COP_PROVIDER_MODE=mock
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
EXA_NUM_RESULTS=5
