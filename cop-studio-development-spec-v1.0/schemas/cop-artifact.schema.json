{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cop-studio.local/schemas/cop-artifact.schema.json",
  "title": "COP Artifact",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "domain",
    "mental_model",
    "goals",
    "shared_foundations",
    "main_processes",
    "stages",
    "concepts",
    "operations",
    "branches",
    "practices",
    "expansion_map",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "artifact_id": {
      "type": "string"
    },
    "domain": {
      "type": "object",
      "required": [
        "name",
        "scope",
        "target_user"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "target_user": {
          "type": "string"
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "mental_model": {
      "type": "object",
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "flow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "outcome"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "prerequisite_goal_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "shared_foundations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "stage_refs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "stage_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "main_processes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "goal_ref",
          "title",
          "start",
          "stage_refs",
          "outcome"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "goal_ref": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "start": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "zero",
                  "foundation"
                ]
              },
              "ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "stage_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outcome": {
            "type": "string"
          },
          "practice_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "local_goal",
          "concept_refs",
          "operation_refs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "local_goal": {
            "type": "string"
          },
          "why_it_exists": {
            "type": "string"
          },
          "local_outcome": {
            "type": "string"
          },
          "concept_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operation_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "branch_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "implementation_details": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "example": {
            "type": [
              "object",
              "null"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "definition",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "related_concept_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "key_operation_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "definition"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "acts_on_concept_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "common_failures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "alternative",
              "extension"
            ]
          },
          "title": {
            "type": "string"
          },
          "parent_stage_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "parent_process_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "practices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "goal_ref",
          "instructions",
          "expected_outcome"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "goal_ref": {
            "type": "string"
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_outcome": {
            "type": "string"
          },
          "checkpoint_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "expansion_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "from_goal_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "generator": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
